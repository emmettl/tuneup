{
  "name": "tuneup",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "homepage": "https://emmettl.github.io/tuneup/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "//": "Driftbox keeps react in devDependencies because it publishes a prebuilt dist and a bin that serves it, so a consumer must not install React. tuneup is a private site that only ever deploys as static files, so the honest split applies: what the source imports at runtime is a dependency.",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  }
}
